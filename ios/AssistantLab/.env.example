# Development only. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is covered by the repository's root .gitignore (.env*), so it will not
# be committed. This key is read ONLY by `swift run AssistantHarness --live`,
# a command-line tool on your Mac. It is never read by AssistantKit or
# AssistantUI, and it is never compiled into the HeliPad app: on a phone the
# key belongs on the server, not in the bundle (PREWALK_PLAN.md A01).

OPENAI_API_KEY=sk-...

# The model id the plan specifies. Not defaulted to anything else: if your
# account cannot reach it, you should see the provider's rejection rather than
# a silent substitution.
HELIPAD_ASSISTANT_MODEL=gpt-5.6-luna

# Optional. For a proxy or a compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
