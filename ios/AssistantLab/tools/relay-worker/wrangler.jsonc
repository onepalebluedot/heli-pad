{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "helipad-assistant-relay",
	"main": "src/index.js",
	// Today, per Cloudflare's guidance for a new project.
	"compatibility_date": "2026-09-12",
	"observability": {
		"enabled": true
	},
	"vars": {
		// Pinned model. The relay refuses a request asking for anything else, so
		// this and the app's AssistantConfiguration must agree.
		"HELIPAD_MODEL": "gpt-5.6-luna",
		// Requests per device per day. A guard on the API bill, not a hard quota.
		"DAILY_LIMIT": "50"
	},
	"kv_namespaces": [
		{
			"binding": "USAGE",
			"id": "64950e35054740c09e2ac64f2592858f"
		}
	]
	// Secrets are deliberately absent - they would end up in git. Set with:
	//   npx wrangler secret put OPENAI_API_KEY
	//   npx wrangler secret put HELIPAD_TOKENS
	// The USAGE KV binding is appended below by `wrangler kv namespace create`.
}